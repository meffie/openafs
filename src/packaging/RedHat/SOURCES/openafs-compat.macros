#
# Check for legacy macro names and convert to the modern names.  This file must
# be included in the spec file before the bcond declarations.
#

#
# Convert --define "build_userspace 1/0" to --with/--without userspace.
#
%if %{defined build_userspace} && ! %{defined _with_userspace} && ! %{defined _without_userspace}
%{warn:--define build_userspace is deprecated; use --with userspace or --without userspace}
%if %{build_userspace}
%global _with_userspace --with-userspace
%else
%global _without_userspace --without-userspace
%endif
%endif

#
# Convert --define "build_modules 1/0" to --with/--without modules.
#
%if %{defined build_modules} && ! %{defined _with_modules} && ! %{defined _without_modules}
%{warn:--define build_modules is deprecated; use --with modules or --without modules}
%if %{build_modules}
%global _with_modules --with-modules
%else
%global _without_modules --without-modules
%endif
%endif

#
# Convert --define "build_dkmspkg 1/0" to --with/--without dkms.
#
%if %{defined build_dkmspkg} && ! %{defined _with_dkms} && ! %{defined _without_dkms}
%{warn:--define build_dkmspkg is deprecated; use --with dkms or --without dkms}
%if %{build_dkmspkg}
%global _with_dkms --with-dkms
%else
%global _without_dkms --without-dkms
%endif
%endif

#
# Convert --define "kernvers <version>" to --define "kernel_version <version>"
#
%if %{defined kernvers} && ! %{defined kernel_version}
%{warn:--define kernvers is deprecated; use --define kernel_version}
%global kernel_version %{kernvers}
%endif
